{
  "name": "midstate-sdk",
  "version": "2.9.0",
  "description": "Official JavaScript SDK for the Midstate Blockchain",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./bincode": "./src/bincode.js",
    "./pkg/*": "./pkg/*",
    "./reorg": "./src/reorg.js",
    "./miner": "./src/miner.js",
    "./pool": "./src/pool.js",
    "./miner-pool": "./src/miner-pool.js",
    "./miner-worker": "./src/miner-worker.js",
    "./dex": "./src/dex.js",
    "./launcher": "./src/launcher.js",
    "./compiler": "./src/compiler.js",
    "./vm": "./src/vm.js",
    "./pump": "./src/pump.js"
  },
  "files": [
    "pkg",
    "src"
  ],
  "scripts": {
    "test": "node test-bincode.mjs && node test-wallet.mjs && node test-reorg.mjs && node test-miner.mjs && node test-dex.mjs && node test-launcher.mjs && node test-compiler.mjs && node test-pump.mjs",
    "test:codec": "node test-bincode.mjs",
    "test:wallet": "node test-wallet.mjs",
    "test:live": "node test.js",
    "build": "rollup -c",
    "test:reorg": "node test-reorg.mjs",
    "test:miner": "node test-miner.mjs",
    "smoke": "node smoke-live.mjs",
    "test:dex": "node test-dex.mjs",
    "test:launcher": "node test-launcher.mjs",
    "test:compiler": "node test-compiler.mjs",
    "test:pump": "node test-pump.mjs"
  },
  "keywords": [
    "midstate",
    "crypto",
    "blockchain",
    "post-quantum"
  ],
  "author": "",
  "license": "GPL",
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/identify": "^4.1.6",
    "@libp2p/ping": "^3.1.5",
    "@libp2p/tcp": "^11.0.20",
    "@libp2p/utils": "^7.2.1",
    "@libp2p/webrtc": "^6.0.23",
    "@multiformats/multiaddr": "^13.0.3",
    "it-pipe": "^3.0.1",
    "libp2p": "^3.3.2"
  }
}
